{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssistantDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "message"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "progress",
        "milestone",
        "final_answer",
        "request_user_input"
      ]
    },
    "message": { "type": "string" }
  }
}
